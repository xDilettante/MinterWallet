<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             xmlns:mobile="using:MinterWallet.Mobile"
             x:Class="MinterWallet.Mobile.MobileRoot"
             x:DataType="local:Shell"
             Background="{DynamicResource Bg}">
  <!-- The phone's single view: the shell's page (first run, unlock or the wallet) and, over it, the confirmation sheet. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="local:WelcomeViewModel"><views:WelcomeView /></DataTemplate>
    <DataTemplate DataType="local:CreateWalletViewModel"><views:CreateWalletView /></DataTemplate>
    <DataTemplate DataType="local:ImportViewModel"><views:ImportView /></DataTemplate>
    <DataTemplate DataType="local:UnlockViewModel"><views:UnlockView /></DataTemplate>
    <DataTemplate DataType="local:MainViewModel"><mobile:MobileMainView /></DataTemplate>
  </UserControl.DataTemplates>
  <Panel x:Name="SafeArea">
    <ContentControl Content="{Binding Page}" Classes="mobilePage" />
    <mobile:ConfirmSheet x:Name="Sheet" IsVisible="False" />
  </Panel>
</UserControl>
