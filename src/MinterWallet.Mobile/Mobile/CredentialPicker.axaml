<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet" x:Class="MinterWallet.Mobile.CredentialPicker" x:DataType="local:CredentialChoice">
  <StackPanel Spacing="10">
    <TextBlock Text="Способ защиты" Classes="label" />
    <ListBox x:Name="CredentialMode" Classes="credentialPicker" SelectedIndex="{Binding ModeIndex}" IsVisible="{Binding CanChoose}" AutomationProperties.Name="Способ защиты">
      <ListBoxItem>
        <StackPanel Spacing="4"><TextBlock Text="PIN-код" FontWeight="SemiBold" /><TextBlock Text="6–12 цифр" Classes="caption" /></StackPanel>
      </ListBoxItem>
      <ListBoxItem>
        <StackPanel Spacing="4"><TextBlock Text="Пароль" FontWeight="SemiBold" /><TextBlock Text="От 8 символов" Classes="caption" /></StackPanel>
      </ListBoxItem>
    </ListBox>
    <TextBlock Text="{Binding Description}" Classes="caption prose" />
  </StackPanel>
</UserControl>
