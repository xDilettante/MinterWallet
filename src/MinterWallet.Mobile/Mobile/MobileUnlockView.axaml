<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet" xmlns:views="using:MinterWallet.Views" xmlns:input="using:Avalonia.Input.TextInput"
             x:Class="MinterWallet.Mobile.MobileUnlockView" x:DataType="local:UnlockViewModel" Classes="mobileOnboarding">
  <ScrollViewer><StackPanel MaxWidth="440" Margin="20,40,20,24" Spacing="24" VerticalAlignment="Center">
    <StackPanel Spacing="12"><Border Classes="logo large" HorizontalAlignment="Left"><TextBlock /></Border><TextBlock Text="С возвращением" Classes="h1" /><TextBlock Text="Разблокируйте кошелёк, чтобы продолжить." Classes="prose muted" /></StackPanel>
    <Border Classes="card"><StackPanel Spacing="16"><StackPanel><TextBlock Text="{Binding Credentials.Label}" Classes="label" /><TextBox x:Name="PasswordBox" Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="{Binding Credentials.Required}" input:TextInputOptions.ContentType="{Binding Credentials.InputType}" AutomationProperties.Name="{Binding Credentials.Label}" local:AutoFocus.IsEnabled="{Binding !Credentials.BiometricsEnabled}" /></StackPanel><views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" /><ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" /><Button Content="Разблокировать" Command="{Binding Unlock}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsDefault="True" /><Button x:Name="BiometricUnlockButton" Content="Повторить биометрию" Click="OnBiometric" IsVisible="{Binding Credentials.BiometricsEnabled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></StackPanel></Border>
    <Button Content="{Binding ForgotText}" Command="{Binding Forgot}" Classes="link" HorizontalAlignment="Center" />
    <Border Classes="card" IsVisible="{Binding Forgetting}"><StackPanel Spacing="16"><TextBlock Text="{Binding StartOverText}" Classes="prose" /><Button Content="Восстановить заново" Command="{Binding StartOver}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /><Button Content="Отмена" Command="{Binding Forgot}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" /></StackPanel></Border>
    <TextBlock Text="{Binding Version}" Classes="caption" HorizontalAlignment="Center" />
  </StackPanel></ScrollViewer>
</UserControl>
