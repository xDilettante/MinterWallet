<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet" xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.ReceivePanel" x:DataType="local:MainViewModel">
      <Border Classes="card" IsVisible="{Binding ShowReceive}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
          <local:QrView Text="{Binding Request.QrText}" Width="196" Height="196" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Получить" Classes="h2" />
            <TextBlock Classes="muted prose mobileHint" Text="Отправьте на этот адрес монеты Minter — BIP или любые токены сети. Покажите QR-код или скопируйте адрес целиком; при отправке с другого устройства сверьте его целиком." />
            <SelectableTextBlock local:AddressMarks.Text="{Binding AddressText}" Classes="mono" FontSize="15" TextWrapping="Wrap" />
            <Button Command="{Binding CopyAddress}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="{Binding CopyLabel}" /></StackPanel>
            </Button>
            <Border Classes="divider" Margin="0,6" />
            <StackPanel Spacing="10" DataContext="{Binding Request}" x:DataType="local:PaymentRequestViewModel">
              <TextBlock Text="Попросить сумму" Classes="label" Margin="0" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Amount}" Classes="mono" PlaceholderText="Сумма" AutomationProperties.Name="Сумма" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Coins}" SelectedItem="{Binding Coin}" MinWidth="120" AutomationProperties.Name="Монета" />
              </Grid>
              <TextBox Text="{Binding Message}" PlaceholderText="Сообщение (необязательно)" AutomationProperties.Name="Сообщение" />
              <views:NoticeBar Classes="inline" Text="{Binding Problem}" Tone="Warning" />
              <StackPanel Spacing="8" IsVisible="{Binding HasLink}">
                <TextBlock Classes="caption prose mobileHint" Text="QR-код теперь — ссылка на перевод с этой суммой: её откроет кошелёк Minter. Ссылкой можно и просто поделиться." />
                <SelectableTextBlock Text="{Binding Link}" Classes="mono caption" TextWrapping="Wrap" />
                <Button Command="{Binding Copy}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="{Binding CopyLabel}" /></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <Border Classes="divider" Margin="0,6" />
            <StackPanel Spacing="10" DataContext="{Binding RedeemCheck}" x:DataType="local:CheckRedeemViewModel">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Command="{Binding Paste}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="paste" Width="16" Height="16" /><TextBlock Text="Вставить" /></StackPanel>
                </Button>
                <TextBlock Text="Есть чек? Погасите его на этот счёт" Classes="label" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Text}" Classes="mono" PlaceholderText="Mc…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" AutomationProperties.Name="Чек" />
              <views:NoticeBar Classes="inline" Text="{Binding Info}" Tone="{Binding InfoTone}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Погасить" Command="{Binding Redeem}" Classes="accent" Margin="8,0,0,0" />
                <TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Пароль чека" AutomationProperties.Name="Пароль чека" />
              </DockPanel>
              <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
</UserControl>
