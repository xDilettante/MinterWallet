<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.HistoryPage"
             x:DataType="local:MainViewModel">
  <Grid Margin="32,28,32,24" RowDefinitions="Auto,Auto,*" RowSpacing="14" DataContext="{Binding History}" x:DataType="local:HistoryViewModel">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="icon" Command="{Binding Export}" ToolTip.Tip="Сохранить всю историю в CSV — для учёта и налогов" AutomationProperties.Name="Сохранить в CSV"><local:Icon Kind="download" /></Button>
        <Button Classes="icon" Command="{Binding Load}" ToolTip.Tip="Обновить" AutomationProperties.Name="Обновить"><local:Icon Kind="refresh" /></Button>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="История" Classes="h1" />
        <TextBlock Text="Кошелёк расшифровывает транзакции сам, из исходных байтов. Нажмите на транзакцию — откроются подробности." Classes="muted prose" />
      </StackPanel>
    </DockPanel>
    <StackPanel Grid.Row="1" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Loading}" />
      <TextBlock Text="{Binding Note}" Classes="caption prose" IsVisible="{Binding HasNote}" />
      <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
    </StackPanel>
    <Panel Grid.Row="2">
      <DockPanel>
      <Button DockPanel.Dock="Bottom" Content="Показать ещё" Command="{Binding More}" IsVisible="{Binding HasMore}" HorizontalAlignment="Center" Margin="0,10,0,0" />
      <ListBox Classes="rows" ItemsSource="{Binding GroupedItems}" AutomationProperties.Name="Транзакции" x:Name="Transactions">
        <ListBox.DataTemplates>
          <DataTemplate DataType="local:DateGroupHeader" x:DataType="local:DateGroupHeader">
            <Border Classes="dateHeader" Margin="0,16,0,8" Focusable="False" IsHitTestVisible="False">
              <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="14" VerticalAlignment="Center">
                <Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Background="{DynamicResource Well}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,5">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <local:Icon Kind="history" Width="14" Height="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Height="1" Background="{DynamicResource Line}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
          <DataTemplate DataType="local:HistoryItem" x:DataType="local:HistoryItem">
            <StackPanel Spacing="10" Margin="0,4">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="avatar" Classes.success="{Binding Incoming}" Classes.danger="{Binding Failed}" Width="36" Height="36" VerticalAlignment="Top">
                  <local:Icon Kind="{Binding Glyph}" Width="18" Height="18" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock local:AddressMarks.Text="{Binding PartiesLine}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasPartiesLine}" />
                  <TextBlock Text="{Binding Payload}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasPayload}" />
                  <TextBlock Text="{Binding FailedText}" Classes="caption" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="{Binding Failed}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" MinWidth="130">
                  <ItemsControl ItemsSource="{Binding Moves}" HorizontalAlignment="Right">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:MoveItem">
                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" HorizontalAlignment="Right" Classes.up="{Binding Up}" Classes.down="{Binding Down}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding CommissionText}" Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding HasCommission}" />
                  <TextBlock Text="{Binding TimeAndHeight}" Classes="caption" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
              <Border Classes="well" IsVisible="{Binding Expanded}" Margin="48,0,0,0">
                <StackPanel Spacing="8">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:DetailRow">
                        <Grid ColumnDefinitions="130,*" ColumnSpacing="12">
                          <TextBlock Text="{Binding Label}" Classes="muted" FontSize="13" />
                          <SelectableTextBlock Grid.Column="1" local:AddressMarks.Text="{Binding Value}" FontSize="13" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Command="{Binding $parent[ListBox].((local:HistoryViewModel)DataContext).CopyHash}" CommandParameter="{Binding Hash}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="copy" Width="14" Height="14" /><TextBlock Text="Скопировать хеш" /></StackPanel>
                    </Button>
                    <Button Command="{Binding $parent[ListBox].((local:HistoryViewModel)DataContext).OpenInExplorer}" CommandParameter="{Binding Hash}"
                            IsVisible="{Binding $parent[ListBox].((local:HistoryViewModel)DataContext).OnMainnet}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="search" Width="14" Height="14" /><TextBlock Text="Открыть в обозревателе" /></StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
      </DockPanel>
      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,0,0,60">
        <Border Classes="avatar" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center"><local:Icon Kind="history" Width="22" Height="22" /></Border>
        <TextBlock Text="{Binding EmptyText}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
      </StackPanel>
    </Panel>
  </Grid>
</UserControl>