<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.CreateWalletView"
             x:DataType="local:CreateWalletViewModel">
  <ScrollViewer>
    <StackPanel Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,32" Spacing="18">
      <Button Classes="link" Command="{Binding Back}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="back" Width="16" Height="16" /><TextBlock Text="Назад" /></StackPanel>
      </Button>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <Border Classes="step" Classes.active="{Binding IsStep1}" Classes.done="{Binding Past1}"><TextBlock Text="1. Фраза" /></Border>
        <Border Grid.Column="1" Classes="step" Classes.active="{Binding IsStep2}" Classes.done="{Binding Past2}"><TextBlock Text="2. Проверка — по желанию" /></Border>
        <Border Grid.Column="2" Classes="step" Classes.active="{Binding IsStep3}"><TextBlock Text="3. Пароль" /></Border>
      </Grid>

      <!-- 1. The phrase -->
      <StackPanel Spacing="14" IsVisible="{Binding IsStep1}">
        <TextBlock Text="Фраза восстановления" Classes="h1" />
        <TextBlock Classes="muted prose"
                   Text="Эти 12 слов — ключ ко всем средствам кошелька: по ним его можно восстановить на любом устройстве, и любой, кто их знает, может распорядиться средствами. Сохраните фразу так, как вам удобно — запишите или скопируйте в менеджер паролей." />
        <Border Classes="card" Padding="12">
          <ItemsControl ItemsSource="{Binding Words}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:PhraseWord">
                <Border Classes="word">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding Number}" Classes="caption mono" Width="18" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Word}" Classes="mono" FontSize="16" FontWeight="Medium" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Далее" Command="{Binding Next}" Classes="accent" MinWidth="120" />
          <Button Command="{Binding Copy}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" /><TextBlock Text="Копировать фразу" /></StackPanel>
          </Button>
        </DockPanel>
      </StackPanel>

      <!-- 2. Optional check -->
      <StackPanel Spacing="14" IsVisible="{Binding IsStep2}">
        <TextBlock Text="Проверьте фразу" Classes="h1" />
        <TextBlock Text="{Binding CheckHint}" Classes="muted prose" />
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <StackPanel><TextBlock Text="{Binding Ask1}" Classes="label" /><TextBox Text="{Binding Answer1}" Classes="mono" /></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Ask2}" Classes="label" /><TextBox Text="{Binding Answer2}" Classes="mono" /></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Ask3}" Classes="label" /><TextBox Text="{Binding Answer3}" Classes="mono" /></StackPanel>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Пропустить" Command="{Binding Skip}" MinWidth="120" />
          <Button Content="Проверить" Command="{Binding Check}" Classes="accent" MinWidth="120" />
        </StackPanel>
      </StackPanel>

      <!-- 3. Password -->
      <StackPanel Spacing="14" IsVisible="{Binding IsStep3}">
        <TextBlock Text="Пароль кошелька" Classes="h1" />
        <TextBlock Classes="muted prose"
                   Text="Пароль шифрует ключи на этом устройстве (Argon2id, AES-256-GCM) и спрашивается при входе и перед каждой подписью. Забытый пароль не восстановить — но кошелёк всегда можно восстановить по фразе." />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel><TextBlock Text="Пароль" Classes="label" /><TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" /></StackPanel>
            <StackPanel><TextBlock Text="Пароль ещё раз" Classes="label" /><TextBox Text="{Binding Repeat}" PasswordChar="•" Classes="revealPasswordButton" /></StackPanel>
            <TextBlock Text="{Binding PasswordHint}" Classes="caption" />
          </StackPanel>
        </Border>
        <Button Content="Создать кошелёк" Command="{Binding Finish}" Classes="accent" HorizontalAlignment="Right" MinWidth="160" />
      </StackPanel>

      <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
