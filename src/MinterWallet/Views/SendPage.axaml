<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.SendPage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="18" MaxWidth="640">
      <TextBlock Text="Отправить" Classes="h1" />
      <ListBox Classes="segmented" SelectedIndex="{Binding Send.ModeIndex}" AutomationProperties.Name="Кому">
        <ListBoxItem Content="Одному получателю" />
        <ListBoxItem Content="Нескольким сразу" />
        <ListBoxItem Content="Чеком" />
        <ListBoxItem Content="В BSC / Ethereum" />
      </ListBox>

      <!-- One recipient -->
      <StackPanel Spacing="18" DataContext="{Binding Send}" x:DataType="local:SendViewModel" IsVisible="{Binding Single}">
        <Border Classes="card">
          <StackPanel Spacing="16">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Classes="link" Command="{Binding Paste}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="paste" Width="16" Height="16" /><TextBlock Text="Вставить" /></StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Classes="link" Margin="0,0,16,0" x:Name="ContactsButton">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="users" Width="16" Height="16" /><TextBlock Text="Контакты" /></StackPanel>
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <StackPanel Width="380" Spacing="6">
                        <TextBlock Text="Адресная книга пуста: получатели появятся здесь после первого перевода, а имена можно задать в разделе «Счета»."
                                   Classes="caption prose" IsVisible="{Binding !HasContacts}" />
                        <ListBox Classes="rows" ItemsSource="{Binding Contacts}" MaxHeight="320" x:Name="ContactsList">
                          <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ContactItem">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock local:AddressMarks.Text="{Binding AddressText}" Classes="caption mono" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <TextBlock Text="Получатель" Classes="label" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Recipient}" Classes="mono" PlaceholderText="Mx…" AutomationProperties.Name="Адрес получателя" />
              <views:NoticeBar Classes="inline" Text="{Binding RecipientCheck}" Tone="{Binding RecipientTone}" />
              <StackPanel IsVisible="{Binding IsNewRecipient}" Margin="0,10,0,0">
                <TextBlock Text="Имя в адресной книге (необязательно)" Classes="caption" Margin="0,0,0,4" />
                <TextBox Text="{Binding RecipientName}" PlaceholderText="Например, Иван" AutomationProperties.Name="Имя получателя" />
              </StackPanel>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Монета" Classes="label" />
              <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding Coin}" HorizontalAlignment="Stretch" AutomationProperties.Name="Монета">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:BalanceItem">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" />
                      <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                    </DockPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Сумма" Classes="label" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Всё" Command="{Binding All}" Margin="8,0,0,0" ToolTip.Tip="Весь баланс монеты за вычетом комиссии, если она платится той же монетой" />
                <TextBox Text="{Binding Amount}" Classes="mono" PlaceholderText="0.0" AutomationProperties.Name="Сумма" />
              </DockPanel>
              <TextBlock Text="{Binding Available}" Classes="caption" Margin="0,6,0,0" />
            </StackPanel>
            <Expander Header="Сообщение и монета комиссии" HorizontalAlignment="Stretch">
              <StackPanel Spacing="14">
                <StackPanel>
                  <TextBlock Text="Сообщение (payload), необязательно" Classes="label" />
                  <TextBox Text="{Binding Payload}" MaxLength="10000" PlaceholderText="Видно всем в блокчейне" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Комиссию платить в" Classes="label" />
                  <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding GasCoin}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="local:BalanceItem">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" />
                          <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                        </DockPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Продолжить" Command="{Binding SendNow}" Classes="accent" MinWidth="150" />
          <TextBlock Text="Перед подписью покажем все данные и спросим пароль." Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>

      <!-- Several recipients in one transaction -->
      <!-- A check: coins for whoever has the check and its password -->
      <Panel IsVisible="{Binding Send.ByCheck}">
      <StackPanel Spacing="18" DataContext="{Binding IssueCheck}" x:DataType="local:CheckIssueViewModel">
        <TextBlock Classes="muted prose" Text="Чек — это обещание выплаты: вы подписываете его здесь, а получатель гасит по паролю, когда удобно. Монеты спишутся со счёта только при погашении, поэтому держите их на счёте до тех пор." />
        <Border Classes="card" IsVisible="{Binding !HasIssued}">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Монета" Classes="label" />
                <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding Coin}" HorizontalAlignment="Stretch" AutomationProperties.Name="Монета чека">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:BalanceItem">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Сумма" Classes="label" />
                <TextBox Text="{Binding Amount}" Classes="mono" PlaceholderText="0.0" AutomationProperties.Name="Сумма чека" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Available}" Classes="caption" Margin="0,-10,0,0" />
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Пароль чека" Classes="label" />
                <TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" AutomationProperties.Name="Пароль чека" />
                <TextBlock Text="Получатель введёт его при погашении. Это не пароль кошелька." Classes="caption" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Действует, дней" Classes="label" />
                <TextBox Text="{Binding Days}" AutomationProperties.Name="Срок чека в днях" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Button Content="Выписать чек" Command="{Binding Issue}" Classes="accent" MinWidth="150" HorizontalAlignment="Right" IsVisible="{Binding !HasIssued}" />
        <Border Classes="card" IsVisible="{Binding HasIssued}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20">
            <local:QrView Text="{Binding Issued}" Width="220" Height="220" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="12">
              <TextBlock Text="{Binding IssuedInfo}" Classes="prose" FontWeight="Medium" />
              <SelectableTextBlock Text="{Binding Issued}" Classes="mono caption" TextWrapping="Wrap" MaxHeight="120" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding Copy}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="Копировать чек" /></StackPanel>
                </Button>
                <Button Content="Выписать ещё" Command="{Binding Clear}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>
      </Panel>

      <Panel IsVisible="{Binding Send.Multiple}">
      <StackPanel Spacing="18" DataContext="{Binding Multisend}" x:DataType="local:MultisendViewModel">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="link" Command="{Binding Paste}">
                <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="paste" Width="16" Height="16" /><TextBlock Text="Вставить" /></StackPanel>
              </Button>
              <TextBlock Text="Получатели" Classes="label" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="caption prose" Text="По строке на получателя: «Mx… сумма [монета]». Без монеты — базовая. До 100 строк, одна транзакция и одна комиссия." />
            <TextBox Text="{Binding Lines}" AcceptsReturn="True" Height="240" Classes="mono" TextWrapping="NoWrap"
                     PlaceholderText="Mx… 10&#10;Mx… 2.5 BIP" AutomationProperties.Name="Получатели" />
            <views:NoticeBar Classes="inline" Text="{Binding Summary}" Tone="{Binding SummaryTone}" />
          </StackPanel>
        </Border>
        <Button Content="Продолжить" Command="{Binding SendNow}" Classes="accent" MinWidth="150" HorizontalAlignment="Right" />
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>
      </Panel>

      <!-- Out to Ethereum or BSC through Minter Hub -->
      <Panel IsVisible="{Binding Send.IsBridge}">
      <StackPanel Spacing="18" DataContext="{Binding Hub}" x:DataType="local:BridgeViewModel">
        <TextBlock Classes="muted prose" Text="Вывод монет Minter в Ethereum или BSC через мост Minter Hub: USDTE — в Ethereum, USDTBSC — в BSC, ETH — в обе сети, и другие. Мост берёт 1 % и плату за газ сети назначения." />
        <views:NoticeBar Text="Мост Minter Hub работает только в основной сети Minter." Tone="Info" IsVisible="{Binding IsUnavailable}" />
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Монета" Classes="label" />
                <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding Coin}" HorizontalAlignment="Stretch" PlaceholderText="Нет монет, которые выводит мост" AutomationProperties.Name="Монета для вывода">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:BalanceItem">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Сеть" Classes="label" />
                <ListBox Classes="segmented" SelectedIndex="{Binding NetworkIndex}" AutomationProperties.Name="Сеть назначения">
                  <ListBoxItem Content="Ethereum" />
                  <ListBoxItem Content="BSC" />
                </ListBox>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding NetworkHint}" Classes="caption prose" />
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Classes="link" Content="Мой адрес в этой сети" Command="{Binding Own}" />
                <TextBlock Text="Получатель — адрес 0x…" Classes="label" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Recipient}" Classes="mono" PlaceholderText="0x…" AutomationProperties.Name="Получатель в сети назначения" />
              <views:NoticeBar Classes="inline" Text="{Binding RecipientCheck}" Tone="{Binding RecipientTone}" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Сумма" Classes="label" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Всё" Command="{Binding All}" Margin="8,0,0,0" />
                <TextBox Text="{Binding Amount}" Classes="mono" PlaceholderText="0.0" AutomationProperties.Name="Сумма вывода" />
              </DockPanel>
              <TextBlock Text="{Binding Available}" Classes="caption" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Estimate}" Classes="prose" />
          </StackPanel>
        </Border>
        <Button Content="Продолжить" Command="{Binding SendNow}" Classes="accent" MinWidth="150" HorizontalAlignment="Right" />
        <Border Classes="well" IsVisible="{Binding HasLink}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Tracking}" Classes="prose" />
            <Button Content="Открыть получателя в обозревателе сети" Command="{Binding OpenLink}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
