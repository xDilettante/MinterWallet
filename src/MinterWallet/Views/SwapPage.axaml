<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.SwapPage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="18" MaxWidth="640">
      <TextBlock Text="Обмен" Classes="h1" />
      <ListBox Classes="segmented" SelectedIndex="{Binding TradeModeIndex}" AutomationProperties.Name="Обмен, ордер или ликвидность">
        <ListBoxItem Content="Обменять сейчас" />
        <ListBoxItem Content="Лимитный ордер" />
        <ListBoxItem Content="Ликвидность" />
      </ListBox>

      <!-- A limit order -->
      <Panel IsVisible="{Binding IsOrders}">
      <StackPanel Spacing="18" DataContext="{Binding Orders}" x:DataType="local:OrdersViewModel">
        <TextBlock Classes="muted prose mobileIntro" Text="Ордер продаёт монету по вашей цене, когда пул до неё дойдёт. Монеты на продажу уходят в ордер сразу; отменить его можно в любой момент — они вернутся." />
        <Border Classes="card">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="Продаю" Classes="label" />
                <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding Sell}" HorizontalAlignment="Stretch" AutomationProperties.Name="Продаю">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:BalanceItem">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <local:CoinBadge Symbol="{Binding Symbol}" CoinId="{Binding CoinId}" Size="24" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Хочу получить" Classes="label" />
                <views:CoinPicker DataContext="{Binding Buy}" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel><TextBlock Text="Сколько продать" Classes="label" /><TextBox Text="{Binding AmountSell}" Classes="mono" PlaceholderText="0.0" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Сколько получить" Classes="label" /><TextBox Text="{Binding AmountBuy}" Classes="mono" PlaceholderText="0.0" /></StackPanel>
            </Grid>
            <TextBlock Text="{Binding Range}" Classes="caption prose" />
          </StackPanel>
        </Border>
        <Button Content="Выставить ордер" Command="{Binding Place}" Classes="accent" MinWidth="150" HorizontalAlignment="Right" />
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding Load}" ToolTip.Tip="Обновить" AutomationProperties.Name="Обновить ордера"><local:Icon Kind="refresh" Width="16" Height="16" /></Button>
            <TextBlock Text="Мои ордера" Classes="h2" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Открытых ордеров нет (ищутся по истории этого счёта)." Classes="caption" IsVisible="{Binding !HasMine}" />
          <Border Classes="card" Padding="0" IsVisible="{Binding HasMine}">
            <ItemsControl Classes="rows" ItemsSource="{Binding Mine}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OrderItem">
                  <Border Classes="row">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Отменить" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((local:OrdersViewModel)DataContext).Cancel}" CommandParameter="{Binding}" />
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Caption}" Classes="caption" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
      </Panel>

      <!-- Liquidity -->
      <Panel IsVisible="{Binding IsLiquidity}">
      <StackPanel Spacing="18" DataContext="{Binding Liquidity}" x:DataType="local:LiquidityViewModel">
        <TextBlock Classes="muted prose mobileIntro" Text="Добавьте две монеты в пул — и получайте долю комиссий с каждого обмена через него. Выйти можно в любой момент: вернётся ваша доля обеих монет." />
        <StackPanel Spacing="10">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="icon" Command="{Binding Load}" ToolTip.Tip="Обновить" AutomationProperties.Name="Обновить позиции"><local:Icon Kind="refresh" Width="16" Height="16" /></Button>
            <TextBlock Text="Мои позиции" Classes="h2" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="Позиций нет." Classes="caption" IsVisible="{Binding !HasPositions}" />
          <ListBox Classes="rows" ItemsSource="{Binding Positions}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasPositions}" AutomationProperties.Name="Позиции">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:PositionItem">
                <StackPanel Spacing="1">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ShareText}" Classes="caption" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding AmountsText}" Classes="caption" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPositions}">
            <TextBlock Text="Вывести из выбранной:" Classes="muted" VerticalAlignment="Center" />
            <Button Content="25 %" Command="{Binding Withdraw}" CommandParameter="25" />
            <Button Content="50 %" Command="{Binding Withdraw}" CommandParameter="50" />
            <Button Content="Всё" Command="{Binding Withdraw}" CommandParameter="100" />
          </StackPanel>
        </StackPanel>
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="Добавить в пул" Classes="label" Margin="0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding CoinA}" HorizontalAlignment="Stretch" AutomationProperties.Name="Первая монета">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:BalanceItem">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:CoinBadge Symbol="{Binding Symbol}" CoinId="{Binding CoinId}" Size="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <views:CoinPicker Grid.Column="1" DataContext="{Binding CoinB}" />
            </Grid>
            <TextBox Text="{Binding AmountA}" Classes="mono" PlaceholderText="Сколько первой монеты" AutomationProperties.Name="Сумма первой монеты" />
            <TextBlock Text="{Binding NeedText}" Classes="caption prose" />
            <Button Content="Добавить ликвидность" Command="{Binding Add}" Classes="accent" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
        <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>
      </Panel>

      <!-- Swap now -->
      <Panel IsVisible="{Binding IsSwapNow}">
      <StackPanel Spacing="18" DataContext="{Binding Swap}" x:DataType="local:SwapViewModel">
      <TextBlock Classes="muted prose mobileIntro" Text="Выберите монеты и сумму — цену и маршрут кошелёк найдёт сам. Допустимое проскальзывание задаёт границу цены: дальше неё сеть сделку не проведёт." />
      <ListBox Classes="segmented" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="Режим обмена">
        <ListBoxItem Content="Продать точную сумму" />
        <ListBoxItem Content="Купить точную сумму" />
      </ListBox>

      <!-- Swap cards layout -->
      <StackPanel Spacing="0">
        <!-- Pay Card -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Available}" Classes="caption" VerticalAlignment="Center" />
              <TextBlock Text="Отдаю" Classes="label" Margin="0" />
            </DockPanel>
            <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
              <TextBox x:Name="SellAmount" Text="{Binding Amount}" IsVisible="{Binding ExactInput}" Classes="mono" FontSize="16" PlaceholderText="0.0" AutomationProperties.Name="{Binding AmountLabel}" />
              <Panel IsVisible="{Binding !ExactInput}">
                <SelectableTextBlock Text="{Binding QuoteExpected}" Classes="mono" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasQuote}" />
                <TextBlock Text="—" Classes="muted mono" FontSize="16" VerticalAlignment="Center" IsVisible="{Binding !HasQuote}" />
              </Panel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Coins}" SelectedItem="{Binding Sell}" HorizontalAlignment="Stretch" AutomationProperties.Name="Отдаю">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:BalanceItem">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding AmountShort}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:CoinBadge Symbol="{Binding Symbol}" CoinId="{Binding CoinId}" Size="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" Margin="0,2,0,0" IsVisible="{Binding ExactInput}">
              <Button Content="25 %" Command="{Binding Percent25}" />
              <Button Content="50 %" Command="{Binding Percent50}" />
              <Button Content="75 %" Command="{Binding Percent75}" />
              <Button Content="Всё" Command="{Binding All}" ToolTip.Tip="Весь баланс монеты за вычетом комиссии" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Flip Button -->
        <Button Classes="icon" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" Margin="0,-16,0,-16" ZIndex="2"
                Command="{Binding Flip}" ToolTip.Tip="Поменять местами" AutomationProperties.Name="Поменять местами"
                Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <local:Icon Kind="flip" Width="16" Height="16" />
        </Button>

        <!-- Receive Card -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <DockPanel>
              <TextBlock Text="Получаю" Classes="label" Margin="0" />
            </DockPanel>
            <Grid ColumnDefinitions="*,190" ColumnSpacing="12">
              <TextBox x:Name="BuyAmount" Text="{Binding Amount}" IsVisible="{Binding !ExactInput}" Classes="mono" FontSize="16" PlaceholderText="0.0" AutomationProperties.Name="{Binding AmountLabel}" />
              <Panel IsVisible="{Binding ExactInput}">
                <SelectableTextBlock Text="{Binding QuoteExpected}" Classes="mono" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding HasQuote}" />
                <TextBlock Text="—" Classes="muted mono" FontSize="16" VerticalAlignment="Center" IsVisible="{Binding !HasQuote}" />
              </Panel>
              <views:CoinPicker Grid.Column="1" DataContext="{Binding Buy}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Slippage Setting Card -->
      <Border Classes="well" Padding="14,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ListBox Classes="segmented" SelectedIndex="{Binding SlippageIndex}" AutomationProperties.Name="Проскальзывание">
              <ListBoxItem Content="0.5 %" />
              <ListBoxItem Content="1 %" />
              <ListBoxItem Content="3 %" />
            </ListBox>
            <TextBox Text="{Binding Slippage}" Width="64" VerticalAlignment="Center" AutomationProperties.Name="Своё проскальзывание, %" />
            <TextBlock Text="%" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
          <TextBlock Text="Допустимое проскальзывание" Classes="label" Margin="0" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasQuote}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="10">
          <Panel Grid.Column="2" Grid.RowSpan="2" Width="22" Height="22" VerticalAlignment="Top" ToolTip.Tip="Расчёт обновляется каждые 5 секунд">
            <Ellipse Stroke="{DynamicResource Line}" StrokeThickness="2" />
            <Arc Stroke="{DynamicResource Accent}" StrokeThickness="2" StartAngle="-90" SweepAngle="{Binding QuoteAngle}" IsVisible="{Binding QuoteCounting}" />
            <local:Icon Kind="loader" Width="13" Height="13" Classes="spin" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Requoting}" />
          </Panel>
          <TextBlock Text="Маршрут" Classes="muted" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding QuoteRoute}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Text="{Binding QuoteExpectedLabel}" Classes="muted" />
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
            <SelectableTextBlock Text="{Binding QuoteExpected}" Classes="mono" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding QuoteDelta}" Classes="caption" Classes.up="{Binding QuoteDeltaUp}" Classes.down="{Binding QuoteDeltaDown}" IsVisible="{Binding HasQuoteDelta}" />
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Гарантия сети" Classes="muted" />
          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding QuoteLimit}" Classes="mono" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="caption prose mobileIntro"
                     Text="Оценка — от источника, обновляется каждые 5 секунд. Если цена уйдёт дальше гарантии, транзакция не выполнится и спишется только комиссия." />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Обновить цену" Command="{Binding Estimate}" MinWidth="130" ToolTip.Tip="Цена считается сама, когда заполнены монеты и сумма" />
        <Button Content="Обменять" Command="{Binding SwapNow}" Classes="accent" MinWidth="130" />
      </StackPanel>
      <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      </StackPanel>
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
