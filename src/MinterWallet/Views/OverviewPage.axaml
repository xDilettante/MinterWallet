<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.OverviewPage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="24" MaxWidth="860">
      <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
      <Border Background="{DynamicResource AccentSubtle}" CornerRadius="8" Padding="14,10" IsVisible="{Binding HasUpdate}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Скачать" Command="{Binding OpenUpdate}" Classes="accent" />
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <local:Icon Kind="info" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <views:DerivationPanel DataContext="{Binding Derivation}" />
      <views:NoticeBar Text="{Binding Derivation.Status}" Tone="{Binding Derivation.Tone}" />
      <Border Classes="well" IsVisible="{Binding !Derivation.IsHd}"><TextBlock Text="{Binding Derivation.KindExplanation}" Classes="caption prose" /></Border>
      <Border Background="{DynamicResource WarningSubtle}" CornerRadius="8" Padding="16" IsVisible="{Binding Derivation.NeedsProtection}">
        <StackPanel Spacing="12" DataContext="{Binding Derivation}" x:DataType="local:DerivationViewModel">
          <TextBlock Text="Сначала сохраните путь этого адреса" FontWeight="SemiBold" />
          <TextBlock Text="{Binding RiskText}" Classes="prose" />
          <Button Content="Сохранить профиль путей…" Command="{Binding Export}" HorizontalAlignment="Left" />
          <CheckBox IsChecked="{Binding Acknowledged}" IsEnabled="{Binding BackedUp}">
            <TextBlock Text="Профиль сохранён отдельно; я понимаю, как восстановить этот путь" TextWrapping="Wrap" />
          </CheckBox>
          <Button Content="Разрешить получение на этот адрес" Command="{Binding ConfirmRisk}" IsEnabled="{Binding Acknowledged}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="0">
        <StackPanel>
        <StackPanel Spacing="14" Margin="24">
          <DockPanel>
            <Border DockPanel.Dock="Right" Classes="badge" IsVisible="{Binding IsWatchOnly}"><TextBlock Text="только просмотр — подписи недоступны" /></Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Text="{Binding Derivation.CurrentName}" Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Derivation.CurrentName}" />
              <Button Grid.Column="1" Content="Переименовать" Classes="link" Command="{Binding Derivation.Rename}" />
            </Grid>
          </DockPanel>
          <StackPanel Spacing="8" IsVisible="{Binding Renaming}" DataContext="{Binding Derivation}" x:DataType="local:DerivationViewModel">
            <TextBox Text="{Binding RenameTo}" MaxLength="64" PlaceholderText="Например, «Личные платежи»" AutomationProperties.Name="Название адреса" />
            <TextBlock Text="Название видно только вам. Пустое поле вернёт номер адреса; ключи и средства не изменятся." Classes="caption prose" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Сохранить" Command="{Binding SaveName}" Classes="accent" /><Button Content="Отмена" Command="{Binding CancelName}" />
            </StackPanel>
          </StackPanel>
          <Border Classes="well">
            <Grid ColumnDefinitions="*,Auto">
              <SelectableTextBlock local:AddressMarks.Text="{Binding AddressText}" Classes="mono" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Command="{Binding CopyAddress}" IsEnabled="{Binding CanReceive}" Margin="12,0,0,0" ToolTip.Tip="Скопировать адрес целиком">
                <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="{Binding CopyLabel}" /></StackPanel>
              </Button>
            </Grid>
          </Border>
          <TextBlock local:PathMarks.Text="{Binding Derivation.CurrentPath}" Classes="mono caption" TextWrapping="Wrap" IsVisible="{Binding Derivation.IsHd}" ToolTip.Tip="Назначение / профиль монеты / группа / ветка / индекс. Апостроф обозначает усиление. Путь определяет адрес внутри вашей фразы." />
          <StackPanel Spacing="3">
            <StackPanel Spacing="3" IsVisible="{Binding HasUsd}">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TotalUsdLarge}" Classes="display" VerticalAlignment="Bottom" Margin="0,0,12,0" />
                <TextBlock Text="{Binding TotalRub}" Classes="h1 muted" VerticalAlignment="Bottom" Margin="0,0,0,3" IsVisible="{Binding HasRub}" />
              </WrapPanel>
              <TextBlock Text="{Binding TotalBipSubtitle}" Classes="h2 muted" FontWeight="Medium" ToolTip.Tip="{Binding TotalExact}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !HasUsd}">
              <TextBlock Text="{Binding TotalText}" Classes="display" ToolTip.Tip="{Binding TotalExact}" />
              <TextBlock Text="{Binding BaseSymbol}" Classes="h2 muted" VerticalAlignment="Bottom" Margin="0,0,0,7" />
            </StackPanel>
            <TextBlock Text="{Binding TotalCaption}" Classes="caption" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="accent" Command="{Binding OpenSend}" IsVisible="{Binding CanSign}">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="send" Width="16" Height="16" /><TextBlock Text="Отправить" /></StackPanel>
            </Button>
            <Button Command="{Binding ToggleReceive}" IsEnabled="{Binding CanReceive}">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="receive" Width="16" Height="16" /><TextBlock Text="Получить" /></StackPanel>
            </Button>
            <Button Command="{Binding OpenSwap}" IsVisible="{Binding CanSign}">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="swap" Width="16" Height="16" /><TextBlock Text="Обменять" /></StackPanel>
            </Button>
            <Button Command="{Binding OpenStaking}" IsVisible="{Binding CanSign}">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="stake" Width="16" Height="16" /><TextBlock Text="Делегировать" /></StackPanel>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Border Classes="divider" />
        <TextBlock Text="Монеты" Classes="label" Margin="24,14,24,4" />
        <StackPanel IsVisible="{Binding HasBalances}">
      <ItemsControl Classes="rows" ItemsSource="{Binding Balances}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:BalanceItem">
            <Border Classes="row">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <local:CoinBadge Symbol="{Binding Symbol}" CoinId="{Binding CoinId}" Size="36" />
                <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <SelectableTextBlock Text="{Binding AmountShort}" FontWeight="Medium" HorizontalAlignment="Right" ToolTip.Tip="{Binding Amount}" />
                  <TextBlock Text="{Binding BipText}" Classes="caption" HorizontalAlignment="Right" ToolTip.Tip="{Binding BipTip}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
        </StackPanel>
        <TextBlock Classes="muted prose" Margin="24,4,24,24" IsVisible="{Binding HasNoBalances}"
                   Text="Монет на счёте пока нет. Чтобы пополнить его, скопируйте адрес выше и отправьте на него монеты с другого кошелька или биржи." />
        </StackPanel>
      </Border>

      <StackPanel Spacing="4" IsVisible="{Binding Derivation.IsHd}">
        <TextBlock Text="{Binding Derivation.Summary}" Classes="caption prose" />
        <TextBlock Text="{Binding Derivation.ScanText}" Classes="caption prose" />
        <WrapPanel ItemSpacing="12" LineSpacing="4">
          <TextBlock Text="{Binding Derivation.CheckedAt}" Classes="caption" VerticalAlignment="Center" />
          <Button Content="Обновить сводку" Classes="link" Command="{Binding Derivation.Scan}" />
        </WrapPanel>
      </StackPanel>
      <StackPanel Spacing="10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Вся история" Command="{Binding OpenHistory}" Classes="link" />
          <TextBlock Text="Операции" Classes="h2" />
        </DockPanel>
        <TextBlock Text="{Binding RecentText}" Classes="caption prose" />
        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HistoryItem">
              <Border Classes="card" Margin="0,0,0,8" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <Border Classes="avatar" Classes.success="{Binding Incoming}" Classes.danger="{Binding Failed}" Width="32" Height="32" VerticalAlignment="Top"><local:Icon Kind="{Binding Glyph}" Width="16" Height="16" /></Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock local:AddressMarks.Text="{Binding PartiesLine}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasPartiesLine}" />
                    <TextBlock Text="{Binding FailedText}" Foreground="{DynamicResource Danger}" Classes="caption" IsVisible="{Binding Failed}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Payload}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasPayload}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3" MinWidth="130">
                    <ItemsControl ItemsSource="{Binding Moves}">
                      <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:MoveItem"><TextBlock Text="{Binding Text}" Classes.up="{Binding Up}" Classes.down="{Binding Down}" FontWeight="SemiBold" HorizontalAlignment="Right" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding CommissionText}" Classes="caption" HorizontalAlignment="Right" IsVisible="{Binding HasCommission}" />
                    <TextBlock Text="{Binding OverviewTimeAndHeight}" Classes="caption" HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding ShowReceive}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
          <local:QrView Text="{Binding Request.QrText}" Width="196" Height="196" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Получить" Classes="h2" />
            <TextBlock Classes="muted prose" Text="Отправьте на этот адрес монеты Minter — BIP или любые токены сети. Покажите QR-код или скопируйте адрес целиком; при отправке с другого устройства сверьте его целиком." />
            <SelectableTextBlock local:AddressMarks.Text="{Binding AddressText}" Classes="mono" FontSize="15" TextWrapping="Wrap" />
            <Button Command="{Binding CopyAddress}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="{Binding CopyLabel}" /></StackPanel>
            </Button>
            <Border Classes="divider" Margin="0,6" />
            <StackPanel Spacing="10" DataContext="{Binding Request}" x:DataType="local:PaymentRequestViewModel">
              <TextBlock Text="Попросить сумму" Classes="label" Margin="0" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Amount}" Classes="mono" PlaceholderText="Сумма" AutomationProperties.Name="Сумма" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Coins}" SelectedItem="{Binding Coin}" MinWidth="120" AutomationProperties.Name="Монета" />
              </Grid>
              <TextBox Text="{Binding Message}" PlaceholderText="Сообщение (необязательно)" AutomationProperties.Name="Сообщение" />
              <views:NoticeBar Classes="inline" Text="{Binding Problem}" Tone="Warning" />
              <StackPanel Spacing="8" IsVisible="{Binding HasLink}">
                <TextBlock Classes="caption prose" Text="QR-код теперь — ссылка на перевод с этой суммой: её откроет кошелёк Minter. Ссылкой можно и просто поделиться." />
                <SelectableTextBlock Text="{Binding Link}" Classes="mono caption" TextWrapping="Wrap" />
                <Button Command="{Binding Copy}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="copy" Width="16" Height="16" /><TextBlock Text="{Binding CopyLabel}" /></StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            <Border Classes="divider" Margin="0,6" />
            <StackPanel Spacing="10" DataContext="{Binding RedeemCheck}" x:DataType="local:CheckRedeemViewModel">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="link" Command="{Binding Paste}">
                  <StackPanel Orientation="Horizontal" Spacing="6"><local:Icon Kind="paste" Width="16" Height="16" /><TextBlock Text="Вставить" /></StackPanel>
                </Button>
                <TextBlock Text="Есть чек? Погасите его на этот счёт" Classes="label" Margin="0" VerticalAlignment="Center" />
              </DockPanel>
              <TextBox Text="{Binding Text}" Classes="mono" PlaceholderText="Mc…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" AutomationProperties.Name="Чек" />
              <views:NoticeBar Classes="inline" Text="{Binding Info}" Tone="{Binding InfoTone}" />
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Погасить" Command="{Binding Redeem}" Classes="accent" Margin="8,0,0,0" />
                <TextBox Text="{Binding Password}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Пароль чека" AutomationProperties.Name="Пароль чека" />
              </DockPanel>
              <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Spacing="10" IsVisible="{Binding HasDelegations}">
        <TextBlock Text="В стейкинге" Classes="h2" />
        <Border Classes="card" Padding="0">
          <ItemsControl Classes="rows" ItemsSource="{Binding Delegations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:DelegationItem">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <local:CoinBadge Symbol="{Binding Symbol}" CoinId="{Binding CoinId}" Size="36" />
                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding AmountShort}" FontWeight="Medium" HorizontalAlignment="Right" ToolTip.Tip="{Binding Amount}" />
                      <TextBlock Text="{Binding BipText}" Classes="caption" HorizontalAlignment="Right" ToolTip.Tip="{Binding BipTip}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <StackPanel Spacing="10" IsVisible="{Binding HasFrozen}">
        <TextBlock Text="Заморожено" Classes="h2" />
        <TextBlock Text="Выведенный стейк и блокировки: вернутся на счёт сами, когда сеть дойдёт до указанного блока." Classes="caption" />
        <Border Classes="card" Padding="0">
          <ItemsControl Classes="rows" ItemsSource="{Binding Frozen}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:FrozenItem">
                <Border Classes="row">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="avatar"><local:Icon Kind="lock" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                      <SelectableTextBlock Text="{Binding AmountShort}" FontWeight="Medium" ToolTip.Tip="{Binding Amount}" />
                      <TextBlock Text="{Binding Caption}" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
