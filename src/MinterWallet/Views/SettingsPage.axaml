<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MinterWallet"
             xmlns:views="using:MinterWallet.Views"
             x:Class="MinterWallet.Views.SettingsPage"
             x:DataType="local:MainViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,28,32,32" Spacing="24" MaxWidth="680" DataContext="{Binding Settings}" x:DataType="local:SettingsViewModel">
      <TextBlock Text="Настройки" Classes="h1" />
      <views:NoticeBar Text="{Binding Status}" Tone="{Binding Tone}" />

      <StackPanel Spacing="10">
        <TextBlock Text="Куда подключаться" Classes="h2" />
        <TextBlock Classes="caption prose" Text="Кошелёк читает балансы и отправляет транзакции через MinterGate или API ноды Minter. Ответы источника он не проверяет — выбирайте тот, которому доверяете. Ключи никуда не передаются: подпись делается на этом устройстве." />
        <ListBox Classes="rows" ItemsSource="{Binding Sources}" SelectedIndex="{Binding SourceIndex}" AutomationProperties.Name="Источники">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:SourceItem">
              <Grid ColumnDefinitions="Auto,*">
                <Border Classes="avatar" Width="34" Height="34"><local:Icon Kind="{Binding Glyph}" Width="17" Height="17" /></Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Url}" Classes="caption mono" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Caption}" Classes="caption" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Command="{Binding ShowAdd}">
            <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="plus" Width="16" Height="16" /><TextBlock Text="Свой адрес…" /></StackPanel>
          </Button>
          <Button Command="{Binding Reconnect}">
            <StackPanel Orientation="Horizontal" Spacing="8"><local:Icon Kind="refresh" Width="16" Height="16" /><TextBlock Text="Переподключиться" /></StackPanel>
          </Button>
          <Button Content="Удалить выбранный" Command="{Binding RemoveSource}" IsEnabled="{Binding CanRemove}" />
        </WrapPanel>
        <CheckBox IsChecked="{Binding SkipCertificate}">
          <TextBlock Classes="prose" Text="Не проверять сертификат TLS выбранного источника. Только чтобы понять, в сертификате ли дело: пока проверка выключена, ответы источника может подменить любой посредник в сети. Подпись остаётся на этом устройстве." />
        </CheckBox>
        <Border Classes="card" IsVisible="{Binding Adding}">
          <StackPanel Spacing="14">
            <TextBlock Classes="caption prose" Text="Адрес MinterGate или API v2 ноды Minter. Своя нода на этом компьютере обычно http://127.0.0.1:8843. Перед добавлением кошелёк спросит у источника сеть и высоту." />
            <StackPanel><TextBlock Text="Адрес" Classes="label" /><TextBox Text="{Binding NewUrl}" Classes="mono" PlaceholderText="https://хост:порт" AutomationProperties.Name="Адрес источника" /></StackPanel>
            <StackPanel><TextBlock Text="Название (необязательно)" Classes="label" /><TextBox Text="{Binding NewName}" PlaceholderText="Например, моя нода" /></StackPanel>
            <CheckBox IsChecked="{Binding NewSkipCertificate}"><TextBlock Classes="prose" Text="Не проверять сертификат TLS (небезопасно)" /></CheckBox>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Отмена" Command="{Binding ShowAdd}" />
              <Button Content="Проверить и добавить" Command="{Binding AddSource}" Classes="accent" />
            </StackPanel>
          </StackPanel>
        </Border>
        <CheckBox IsChecked="{Binding HistoryFromExplorer}">
          <TextBlock Classes="prose" Text="Старые транзакции — из обозревателя Minter. Гейт помнит историю с момента своего запуска; более раннюю кошелёк возьмёт у explorer-api.minter.network, и обозреватель узнает, какой адрес вы смотрите." />
        </CheckBox>
        <Button Classes="link" Command="{Binding AcceptNetwork}" HorizontalAlignment="Left" ToolTip.Tip="Если выбранный источник теперь сообщает другую сеть и вы этого ждали">
          <TextBlock Text="Источник сменил сеть — принять новую" FontSize="13" />
        </Button>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="Безопасность" Classes="h2" />
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel><TextBlock Text="Автоблокировка, минут" Classes="label" /><TextBox Text="{Binding AutoLock}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Потолок gas price" Classes="label" ToolTip.Tip="Выше этого кошелёк не подпишет" /><TextBox Text="{Binding GasCap}" /></StackPanel>
            </Grid>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Сохранить" Command="{Binding SaveSecurity}" />
              <TextBlock Text="Фразу восстановления можно посмотреть в разделе «Счета»." Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <Border Classes="divider" />
            <TextBlock Text="Сменить пароль" Classes="label" Margin="0" />
            <TextBox Text="{Binding CurrentPassword}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Текущий пароль" AutomationProperties.Name="Текущий пароль" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <TextBox Text="{Binding NewPassword}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Новый пароль" AutomationProperties.Name="Новый пароль" />
              <TextBox Grid.Column="1" Text="{Binding RepeatPassword}" PasswordChar="•" Classes="revealPasswordButton" PlaceholderText="Новый пароль ещё раз" AutomationProperties.Name="Новый пароль ещё раз" />
            </Grid>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Сменить пароль" Command="{Binding ChangePassword}" />
              <TextBlock Text="{Binding PasswordHint}" Classes="caption" VerticalAlignment="Center" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="Язык" Classes="h2" />
        <ListBox Classes="segmented" SelectedIndex="{Binding LanguageIndex}" AutomationProperties.Name="Язык">
          <ListBoxItem Content="Как в системе" />
          <ListBoxItem Content="Русский" />
          <ListBoxItem Content="English" />
        </ListBox>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="Вид" Classes="h2" />
        <StackPanel>
          <TextBlock Text="Тема" Classes="label" />
          <ListBox Classes="segmented" SelectedIndex="{Binding ThemeIndex}" AutomationProperties.Name="Тема">
            <ListBoxItem Content="Как в системе" />
            <ListBoxItem Content="Тёмная" />
            <ListBoxItem Content="Светлая" />
          </ListBox>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Адрес" Classes="label" />
          <ListBox Classes="segmented" SelectedIndex="{Binding AddressIndex}" AutomationProperties.Name="Адрес">
            <ListBoxItem Content="Сплошной" />
            <ListBoxItem Content="Группами по 4" />
          </ListBox>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Знаки после точки" Classes="label" />
          <ListBox Classes="segmented" SelectedIndex="{Binding DecimalsIndex}" AutomationProperties.Name="Знаки после точки">
            <ListBoxItem Content="Авто" />
            <ListBoxItem Content="Все" />
          </ListBox>
        </StackPanel>
        <TextBlock Classes="caption prose" Text="Авто — четыре знака, у сумм меньше единицы — до первых значащих цифр. Точная сумма — в подсказке при наведении." />
      </StackPanel>

      <CheckBox IsChecked="{Binding CheckUpdates}">
        <TextBlock Classes="prose" Text="Сообщать о новых версиях (кошелёк спрашивает GitHub при запуске)" />
      </CheckBox>

      <StackPanel Spacing="2">
        <SelectableTextBlock Text="{Binding DataDirectory, StringFormat='Файлы кошелька: {0}'}" Classes="caption" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Version}" Classes="caption" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
