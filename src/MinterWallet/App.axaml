<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinterWallet.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FF2F6FE0" RegionColor="#FF0E1116" />
        <ColorPaletteResources x:Key="Light" Accent="#FF2563EB" RegionColor="#FFF4F6F9" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://MinterWallet/Theme.axaml" />
  </Application.Styles>
</Application>
